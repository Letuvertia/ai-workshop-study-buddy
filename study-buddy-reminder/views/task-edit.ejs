<%- include('partials/header', { pageTitle: '編輯任務 — 數位學伴' }) %>

<div class="page-shell" style="max-width:720px;">

  <!-- Page Header -->
  <div style="margin-bottom:28px;">
    <a href="/tasks/<%= task.id %>" style="font-size:13px;color:var(--text-secondary);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:14px;">← 返回任務詳情</a>
    <h1 style="font-size:24px;font-weight:800;margin:0;color:var(--text-primary);">編輯任務</h1>
  </div>

  <% if (error) { %>
    <div class="alert alert-error">❌ <%= error %></div>
  <% } %>

  <form action="/tasks/<%= task.id %>/edit" method="POST">

    <!-- 基本資訊 -->
    <div class="card" style="margin-bottom:16px;">
      <div class="section-label">基本資訊</div>

      <div class="field-group">
        <label for="title">任務名稱 <span style="color:#dc2626;">*</span></label>
        <input type="text" id="title" name="title" value="<%= task.title %>" required>
      </div>

      <div class="field-group">
        <label for="goal">任務目標</label>
        <textarea id="goal" name="goal" rows="2"><%= task.goal || '' %></textarea>
        <p class="field-hint">AI 產生的任務目標，可以修改。</p>
      </div>

      <div class="field-group" style="margin-bottom:0;">
        <label for="content">任務內容</label>
        <textarea id="content" name="content" rows="3"><%= task.content || '' %></textarea>
      </div>
    </div>

    <!-- 時間安排 -->
    <div class="card" style="margin-bottom:16px;">
      <div class="section-label">時間安排</div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="field-group" style="margin-bottom:0;">
          <label for="deadline">截止時間</label>
          <input type="datetime-local" id="deadline" name="deadline"
            value="<%= task.deadline ? (() => { try { return new Date(task.deadline).toISOString().slice(0,16); } catch(e){ return ''; } })() : '' %>">
        </div>
        <div class="field-group" style="margin-bottom:0;">
          <label for="available_time">可用時間</label>
          <input type="text" id="available_time" name="available_time"
            value="<%= task.available_time || '' %>" placeholder="例如：每天晚上 1 小時">
        </div>
      </div>
    </div>

    <!-- 工具與狀態 -->
    <div class="card" style="margin-bottom:28px;">
      <div class="section-label">工具與狀態</div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;">
        <div class="field-group" style="margin-bottom:0;">
          <label for="tools">使用工具</label>
          <input type="text" id="tools" name="tools"
            value="<%= task.tools || '' %>" placeholder="例如：ChatGPT、Notion、番茄鐘">
        </div>
        <div class="field-group" style="margin-bottom:0;">
          <label for="status">任務狀態</label>
          <select id="status" name="status">
            <option value="active"    <%= task.status === 'active'    ? 'selected' : '' %>>進行中</option>
            <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>已完成</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Submit Buttons -->
    <div class="btn-row" style="margin-bottom:48px;">
      <button type="submit" class="button button-primary button-lg">💾 儲存變更</button>
      <a href="/tasks/<%= task.id %>" class="button button-secondary button-lg">取消</a>
    </div>

  </form>

  <!-- Danger Zone -->
  <div style="border-top:1px solid var(--border);padding-top:28px;">
    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:14px;">危險操作</div>
    <div style="background:var(--bg-card);border:1px solid rgba(229,83,83,.25);border-radius:var(--r-card);padding:18px 22px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;box-shadow:var(--shadow-sm);">
      <div>
        <div style="font-weight:700;font-size:14px;color:var(--text-primary);margin-bottom:3px;">刪除此任務</div>
        <div style="font-size:13px;color:var(--text-muted);">刪除後無法復原，連同所有 <%= task.reminder_count || 0 %> 則提醒也會一併刪除。</div>
      </div>
      <form action="/tasks/<%= task.id %>/delete" method="POST"
        onsubmit="return confirm('確定要刪除「<%= task.title %>」？\n\n此操作無法復原，所有提醒也會一併刪除。')">
        <button type="submit" class="button button-danger">🗑 刪除任務</button>
      </form>
    </div>
  </div>

</div>

</body>
</html>
