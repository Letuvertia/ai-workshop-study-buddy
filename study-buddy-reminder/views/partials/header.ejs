<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : '數位學伴' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ═══════════════════════════════════════
       Design Tokens — Health Dashboard Style
    ═══════════════════════════════════════ */
    :root {
      /* Surfaces */
      --bg-page:    #eef1f8;   /* 冷灰藍底色 */
      --bg-card:    #ffffff;   /* 浮卡白底 */
      --bg-surface: #f4f6fc;   /* 淡灰面 */

      /* Text — HIGH CONTRAST */
      --text-primary:   #0c0c14;  /* 近黑，有溫度 */
      --text-secondary: #4a4a6a;  /* 深灰紫 */
      --text-muted:     #8a8aaa;  /* 淡灰 */

      /* Borders */
      --border:       rgba(0,0,0,.06);
      --border-light: rgba(0,0,0,.04);

      /* Shadows — 三層柔和，有浮起感 */
      --shadow-card: 0 2px 4px rgba(0,0,0,.03), 0 8px 20px rgba(0,0,0,.07), 0 24px 48px rgba(0,0,0,.04);
      --shadow-sm:   0 1px 3px rgba(0,0,0,.04), 0 4px 12px rgba(0,0,0,.06);
      --shadow-btn:  0 2px 4px rgba(0,0,0,.06), 0 6px 16px rgba(0,0,0,.1);

      /* Gradient text colors */
      --grad-red:    linear-gradient(135deg, #ff7eb3, #ff4757);
      --grad-blue:   linear-gradient(135deg, #74b9ff, #0984e3);
      --grad-green:  linear-gradient(135deg, #55efc4, #00b894);
      --grad-purple: linear-gradient(135deg, #a29bfe, #6c5ce7);
      --grad-amber:  linear-gradient(135deg, #fdcb6e, #e17055);
      --grad-teal:   linear-gradient(135deg, #81ecec, #0d9488);

      /* Radii */
      --r-card:   16px;
      --r-btn:    10px;
      --r-input:  10px;
      --r-icon:   12px;
      --r-pill:   99px;
      --r-sm:     8px;
    }

    /* ═══════════════════════════════════════
       Reset & Base
    ═══════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Manrope', system-ui, -apple-system, sans-serif;
      background: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.6;
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 { font-family: 'Manrope', sans-serif; color: var(--text-primary); line-height: 1.2; }
    h1 { font-size: 28px; font-weight: 800; }
    h2 { font-size: 20px; font-weight: 700; }
    h3 { font-size: 16px; font-weight: 700; }
    a  { color: inherit; }

    /* ═══════════════════════════════════════
       Navigation
    ═══════════════════════════════════════ */
    .top-nav {
      position: sticky; top: 0; z-index: 100;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 0 rgba(0,0,0,.03), 0 2px 8px rgba(0,0,0,.05);
      height: 64px;
    }
    .top-nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 28px;
      height: 100%; display: flex; align-items: center; justify-content: space-between;
    }
    .nav-brand {
      font-size: 17px; font-weight: 800; color: var(--text-primary);
      text-decoration: none; display: flex; align-items: center; gap: 10px;
    }
    .nav-brand-icon {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, #74b9ff, #0984e3);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 12px rgba(9,132,227,.3);
    }
    .nav-links { display: flex; align-items: center; gap: 6px; }
    .nav-link {
      font-size: 14px; font-weight: 600;
      color: var(--text-secondary);
      text-decoration: none; padding: 7px 14px;
      border-radius: var(--r-btn);
      transition: all .15s;
    }
    .nav-link:hover { background: var(--bg-surface); color: var(--text-primary); }
    .nav-link-cta {
      background: linear-gradient(135deg, #74b9ff, #0984e3);
      color: white !important;
      box-shadow: var(--shadow-btn);
      padding: 7px 18px;
    }
    .nav-link-cta:hover { opacity: .9; background: linear-gradient(135deg, #74b9ff, #0984e3); }

    /* ═══════════════════════════════════════
       Page Shell
    ═══════════════════════════════════════ */
    .page-shell { max-width: 1200px; margin: 0 auto; padding: 40px 28px 72px; }

    /* ═══════════════════════════════════════
       Cards — floating with shadow
    ═══════════════════════════════════════ */
    .card {
      background: var(--bg-card);
      border-radius: var(--r-card);
      padding: 22px 24px;
      box-shadow: var(--shadow-card);
      border: 1px solid var(--border-light);
    }
    .card + .card { margin-top: 14px; }
    .card-sm { padding: 14px 18px; border-radius: var(--r-sm); }

    /* ═══════════════════════════════════════
       Buttons
    ═══════════════════════════════════════ */
    .button {
      display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      font-family: 'Manrope', sans-serif; font-size: 14px; font-weight: 700;
      border: none; border-radius: var(--r-btn);
      padding: 9px 20px; cursor: pointer; text-decoration: none;
      transition: all .15s; white-space: nowrap; line-height: 1.5;
    }
    .button:active:not(:disabled) { transform: scale(.98); }
    .button:disabled { opacity: .5; cursor: not-allowed; }

    .button-primary {
      background: linear-gradient(135deg, #74b9ff, #0984e3);
      color: white;
      box-shadow: var(--shadow-btn);
    }
    .button-primary:hover:not(:disabled) { opacity: .9; }

    .button-secondary {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }
    .button-secondary:hover { background: var(--bg-surface); }

    .button-ghost {
      background: transparent; color: var(--text-muted);
      border: none; padding: 7px 12px;
    }
    .button-ghost:hover { color: var(--text-primary); background: var(--bg-surface); }

    .button-danger {
      background: var(--bg-card); color: #e55353; border: 1px solid rgba(229,83,83,.25);
    }
    .button-danger:hover { background: #fff5f5; }

    .button-lg { padding: 12px 28px; font-size: 15px; }
    .button-sm { padding: 6px 14px; font-size: 13px; }
    .button-full { width: 100%; }
    .btn-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

    /* ═══════════════════════════════════════
       Gradient text utility
    ═══════════════════════════════════════ */
    .grad-red, .grad-blue, .grad-green, .grad-purple, .grad-amber, .grad-teal {
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 800;
    }
    .grad-red    { background-image: var(--grad-red); }
    .grad-blue   { background-image: var(--grad-blue); }
    .grad-green  { background-image: var(--grad-green); }
    .grad-purple { background-image: var(--grad-purple); }
    .grad-amber  { background-image: var(--grad-amber); }
    .grad-teal   { background-image: var(--grad-teal); }

    /* ═══════════════════════════════════════
       Icon Circle
    ═══════════════════════════════════════ */
    .icon-circle {
      width: 42px; height: 42px; border-radius: var(--r-icon);
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; flex-shrink: 0;
    }
    .ic-red    { background: linear-gradient(135deg,#ff7eb3,#ff4757); box-shadow: 0 4px 12px rgba(255,71,87,.3); }
    .ic-blue   { background: linear-gradient(135deg,#74b9ff,#0984e3); box-shadow: 0 4px 12px rgba(9,132,227,.3); }
    .ic-green  { background: linear-gradient(135deg,#55efc4,#00b894); box-shadow: 0 4px 12px rgba(0,184,148,.3); }
    .ic-purple { background: linear-gradient(135deg,#a29bfe,#6c5ce7); box-shadow: 0 4px 12px rgba(108,92,231,.3); }
    .ic-amber  { background: linear-gradient(135deg,#fdcb6e,#e17055); box-shadow: 0 4px 12px rgba(225,112,85,.3); }
    .ic-teal   { background: linear-gradient(135deg,#81ecec,#0d9488); box-shadow: 0 4px 12px rgba(13,148,136,.3); }
    .ic-gray   { background: linear-gradient(135deg,#dfe6e9,#b2bec3); }

    /* ═══════════════════════════════════════
       Status Badges
    ═══════════════════════════════════════ */
    .badge {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 10px; border-radius: var(--r-pill);
      font-size: 11px; font-weight: 700; white-space: nowrap;
    }
    .badge-active    { background: rgba(9,132,227,.1);    color: #0984e3; }
    .badge-pending   { background: rgba(225,112,85,.1);   color: #e17055; }
    .badge-sent      { background: rgba(108,92,231,.1);   color: #6c5ce7; }
    .badge-done,
    .badge-completed { background: rgba(0,184,148,.1);    color: #00b894; }
    .badge-overdue   { background: rgba(255,71,87,.1);    color: #ff4757; }
    .badge-cancelled { background: var(--bg-surface);     color: var(--text-muted); }
    .badge-today     { background: rgba(225,112,85,.1);   color: #e17055; }

    /* ═══════════════════════════════════════
       Pill Tags (tools, time, etc.)
    ═══════════════════════════════════════ */
    .pill {
      display: inline-flex; align-items: center;
      font-size: 11px; font-weight: 600; padding: 3px 10px;
      border-radius: var(--r-pill);
    }
    .pill-red    { background: rgba(255,71,87,.1);   color: #ff4757; }
    .pill-blue   { background: rgba(9,132,227,.1);   color: #0984e3; }
    .pill-green  { background: rgba(0,184,148,.1);   color: #00b894; }
    .pill-purple { background: rgba(108,92,231,.1);  color: #6c5ce7; }
    .pill-amber  { background: rgba(225,112,85,.1);  color: #e17055; }
    .pill-teal   { background: rgba(13,148,136,.1);  color: #0d9488; }
    .pill-gray   { background: var(--bg-surface); color: var(--text-muted); border: 1px solid var(--border); }

    /* ═══════════════════════════════════════
       Forms
    ═══════════════════════════════════════ */
    .field-group { margin-bottom: 18px; }
    .field-group label {
      display: block; font-size: 13px; font-weight: 700;
      color: var(--text-secondary); margin-bottom: 7px; letter-spacing: .01em;
    }
    .field-group input[type="text"],
    .field-group input[type="datetime-local"],
    .field-group input[type="number"],
    .field-group textarea,
    .field-group select {
      width: 100%; padding: 10px 14px;
      background: var(--bg-surface);
      border: 1.5px solid transparent;
      border-radius: var(--r-input);
      font-size: 14px; font-family: 'Manrope', sans-serif;
      color: var(--text-primary);
      transition: all .15s; outline: none;
    }
    .field-group input:focus, .field-group textarea:focus, .field-group select:focus {
      background: var(--bg-card);
      border-color: #74b9ff;
      box-shadow: 0 0 0 3px rgba(116,185,255,.2);
    }
    .field-group textarea { resize: vertical; }
    .field-hint { font-size: 12px; color: var(--text-muted); margin-top: 5px; line-height: 1.5; }

    /* ═══════════════════════════════════════
       Chip Selectors
    ═══════════════════════════════════════ */
    .chip-grid { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip-grid input[type="radio"],
    .chip-grid input[type="checkbox"] { position: absolute; opacity: 0; width: 0; }
    .chip-grid label {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 6px 14px; border: 1.5px solid var(--border);
      border-radius: var(--r-pill); font-size: 13px; font-weight: 600;
      cursor: pointer; color: var(--text-secondary);
      background: var(--bg-card); transition: all .15s; user-select: none;
    }
    .chip-grid label:hover { border-color: #74b9ff; color: #0984e3; background: rgba(116,185,255,.08); }
    .chip-grid input:checked + label {
      background: rgba(9,132,227,.1); border-color: #0984e3;
      color: #0984e3; font-weight: 700;
    }

    /* ═══════════════════════════════════════
       Timeline
    ═══════════════════════════════════════ */
    .timeline { position: relative; padding-left: 28px; }
    .timeline::before {
      content: ''; position: absolute; left: 7px; top: 14px; bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, rgba(116,185,255,.6), rgba(116,185,255,.05));
    }
    .timeline-item { position: relative; padding-bottom: 22px; }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-dot {
      position: absolute; left: -23px; top: 3px;
      width: 16px; height: 16px; border-radius: 50%;
      background: linear-gradient(135deg, #74b9ff, #0984e3);
      border: 2px solid var(--bg-card);
      box-shadow: 0 2px 8px rgba(9,132,227,.4);
    }
    .timeline-dot-muted {
      background: var(--bg-surface);
      border-color: var(--bg-card);
      box-shadow: 0 1px 4px rgba(0,0,0,.1);
    }

    /* ═══════════════════════════════════════
       Summary Cards (Dashboard)
    ═══════════════════════════════════════ */
    .summary-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 36px; }
    @media(max-width:768px) { .summary-grid { grid-template-columns: repeat(2,1fr); } }
    @media(max-width:480px) { .summary-grid { grid-template-columns: 1fr; } }

    .summary-card {
      background: var(--bg-card); border-radius: var(--r-card);
      padding: 20px 22px; box-shadow: var(--shadow-card);
      border: 1px solid var(--border-light); text-align: center;
    }
    .summary-num  { font-size: 38px; font-weight: 800; line-height: 1; margin-bottom: 6px; }
    .summary-label { font-size: 11px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    .summary-sub  { font-size: 12px; color: #0984e3; font-weight: 600; margin-top: 6px; }
    .summary-sub-muted { font-size: 12px; color: var(--text-muted); margin-top: 6px; }

    /* ═══════════════════════════════════════
       Alerts
    ═══════════════════════════════════════ */
    .alert { padding: 12px 16px; border-radius: var(--r-sm); font-size: 14px; margin-bottom: 18px; }
    .alert-success { background: rgba(0,184,148,.1); color: #00b894; border: 1px solid rgba(0,184,148,.2); }
    .alert-error   { background: rgba(255,71,87,.1);  color: #ff4757; border: 1px solid rgba(255,71,87,.2); }
    .alert-info    { background: rgba(9,132,227,.08); color: #0984e3; border: 1px solid rgba(9,132,227,.15); }

    /* ═══════════════════════════════════════
       Empty State
    ═══════════════════════════════════════ */
    .empty-state { text-align: center; padding: 44px 24px; }
    .empty-icon  { font-size: 2.2rem; margin-bottom: 12px; }
    .empty-title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
    .empty-desc  { font-size: 14px; color: var(--text-muted); max-width: 280px; margin: 0 auto; line-height: 1.6; }

    /* ═══════════════════════════════════════
       Section
    ═══════════════════════════════════════ */
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .section-title  { font-size: 18px; font-weight: 800; color: var(--text-primary); }
    .section-label  { font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: .08em; text-transform: uppercase; display: block; margin-bottom: 14px; }

    /* ═══════════════════════════════════════
       Guide Box
    ═══════════════════════════════════════ */
    .guide-box {
      background: rgba(116,185,255,.08); border: 1px solid rgba(116,185,255,.2);
      border-radius: var(--r-sm); padding: 10px 14px;
      font-size: 13px; color: #0984e3; margin-top: 8px; line-height: 1.6;
    }

    /* ═══════════════════════════════════════
       Inline Edit
    ═══════════════════════════════════════ */
    .inline-edit { display:none; margin-top:12px; background:var(--bg-surface); border-radius:var(--r-sm); padding:16px; border: 1px solid var(--border); }
    .inline-edit.open { display:block; }
    .ie-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px; }
    @media(max-width:600px){ .ie-grid { grid-template-columns:1fr; } }
    .ie-field label { font-size:12px; font-weight:700; color:var(--text-secondary); display:block; margin-bottom:4px; }
    .ie-field input, .ie-field textarea {
      width:100%; padding:8px 12px;
      background:var(--bg-card);
      border:1.5px solid var(--border);
      border-radius:var(--r-input);
      font-size:13px; font-family:'Manrope',sans-serif; outline:none; color:var(--text-primary);
    }
    .ie-field input:focus, .ie-field textarea:focus { border-color:#74b9ff; }

    /* ═══════════════════════════════════════
       Time Presets
    ═══════════════════════════════════════ */
    .time-presets { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .time-preset {
      padding: 5px 12px; border: 1.5px solid var(--border);
      border-radius: var(--r-pill); font-size: 12px; font-family: inherit;
      cursor: pointer; background: var(--bg-card); color: var(--text-secondary);
      font-weight: 600; transition: all .15s;
    }
    .time-preset:hover { border-color: #74b9ff; color: #0984e3; }
    .time-preset.active { background: rgba(9,132,227,.1); border-color: #0984e3; color: #0984e3; }

    /* ═══════════════════════════════════════
       Utilities
    ═══════════════════════════════════════ */
    .text-muted     { color: var(--text-muted); }
    .text-secondary { color: var(--text-secondary); }
    .fw-700 { font-weight: 700; }
    .fw-800 { font-weight: 800; }
    .text-sm { font-size: 13px; }
    .text-xs { font-size: 11px; }
    .divider { border: none; border-top: 1px solid var(--border); margin: 22px 0; }

    /* ═══════════════════════════════════════
       Chat Widget
    ═══════════════════════════════════════ */
    .chat-overlay {
      position: fixed; inset: 0; background: rgba(12,12,20,.4); z-index: 200;
      display: none; opacity: 0; transition: opacity .25s;
    }
    .chat-overlay.open { display: block; opacity: 1; }

    .chat-panel {
      position: fixed; top: 0; right: 0; bottom: 0; width: 420px;
      background: var(--bg-card); z-index: 201;
      display: flex; flex-direction: column;
      box-shadow: -8px 0 40px rgba(0,0,0,.12);
      transform: translateX(105%); transition: transform .3s cubic-bezier(.4,0,.2,1);
    }
    .chat-panel.open { transform: translateX(0); }
    @media(max-width:480px){ .chat-panel { width: 100%; } }

    .chat-header {
      padding: 18px 20px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 12px; flex-shrink: 0;
    }
    .chat-avatar {
      width: 42px; height: 42px;
      background: linear-gradient(135deg, #74b9ff, #0984e3);
      border-radius: 12px; display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(9,132,227,.3);
    }
    .chat-header-info h3 { font-size: 15px; margin-bottom: 1px; }
    .chat-header-info p  { font-size: 12px; color: var(--text-muted); }
    .chat-close-btn { margin-left:auto; background:none; border:none; font-size:18px; cursor:pointer; color:var(--text-muted); padding:4px; border-radius:6px; }
    .chat-close-btn:hover { color:var(--text-primary); background:var(--bg-surface); }

    .chat-messages { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 10px; }

    .chat-bubble { max-width: 88%; padding: 10px 14px; font-size: 14px; line-height: 1.6; }
    .chat-bubble-assistant {
      background: var(--bg-surface); color: var(--text-primary);
      align-self: flex-start; border-radius: 4px 14px 14px 14px;
    }
    .chat-bubble-user {
      background: linear-gradient(135deg, #74b9ff, #0984e3); color: white;
      align-self: flex-end; border-radius: 14px 4px 14px 14px;
    }
    .chat-bubble-loading {
      background: var(--bg-surface); align-self: flex-start;
      display: flex; gap: 4px; padding: 14px 16px; border-radius: 4px 14px 14px 14px;
    }
    .chat-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); animation: chatBounce .9s ease-in-out infinite; }
    .chat-dot:nth-child(2) { animation-delay: .15s; }
    .chat-dot:nth-child(3) { animation-delay: .3s; }
    @keyframes chatBounce { 0%,60%,100% { transform:translateY(0); } 30% { transform:translateY(-5px); } }

    .chat-footer { padding: 14px 16px; border-top: 1px solid var(--border); flex-shrink: 0; }
    .chat-input-row { display: flex; gap: 8px; margin-bottom: 10px; }
    .chat-input {
      flex: 1; padding: 9px 12px;
      background: var(--bg-surface);
      border: 1.5px solid transparent;
      border-radius: var(--r-input);
      font-size: 14px; font-family: 'Manrope', sans-serif;
      outline: none; resize: none; line-height: 1.5; max-height: 100px;
      color: var(--text-primary);
    }
    .chat-input:focus { background: var(--bg-card); border-color: #74b9ff; }

    @media(max-width:640px) {
      .page-shell { padding: 24px 16px 56px; }
      .card { padding: 16px 18px; }
      h1 { font-size: 22px; }
    }
  </style>
</head>
<body>

<nav class="top-nav">
