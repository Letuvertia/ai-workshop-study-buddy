<%- include('partials/header', { pageTitle: '任務總覽 — 數位學伴' }) %>

<%
const TC = {
  '語言學習': {ic:'ic-red',    pill:'pill-red',    grad:'grad-red',    emoji:'🗣️'},
  '課程作業': {ic:'ic-blue',   pill:'pill-blue',   grad:'grad-blue',   emoji:'📚'},
  '程式':     {ic:'ic-green',  pill:'pill-green',  grad:'grad-green',  emoji:'💻'},
  '研究閱讀': {ic:'ic-purple', pill:'pill-purple', grad:'grad-purple', emoji:'🔬'},
  '寫作':     {ic:'ic-amber',  pill:'pill-amber',  grad:'grad-amber',  emoji:'✍️'},
  '簡報':     {ic:'ic-teal',   pill:'pill-teal',   grad:'grad-teal',   emoji:'📊'},
  '行政':     {ic:'ic-purple', pill:'pill-purple', grad:'grad-purple', emoji:'📋'},
  '規劃':     {ic:'ic-amber',  pill:'pill-amber',  grad:'grad-amber',  emoji:'🗺️'},
  '複習':     {ic:'ic-blue',   pill:'pill-blue',   grad:'grad-blue',   emoji:'🔄'},
  '生活安排': {ic:'ic-green',  pill:'pill-green',  grad:'grad-green',  emoji:'🏠'},
};
function tc(type) { return TC[type] || {ic:'ic-gray', pill:'pill-gray', grad:'', emoji:'📌'}; }
function fmtTime(iso) { try { return new Date(iso).toLocaleString('zh-TW',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}); } catch(e){ return iso||'—'; } }
function daysLeft(iso) { try { const d=Math.ceil((new Date(iso)-new Date())/86400000); if(d<0)return '已逾期'; if(d===0)return '今天截止'; if(d===1)return '明天截止'; return `剩 ${d} 天`; } catch(e){ return ''; } }
%>

<div class="page-shell">

  <!-- Page Header -->
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
    <div>
      <div style="font-size:13px;color:var(--text-muted);margin-bottom:6px;">
        <%= new Date().toLocaleDateString('zh-TW',{year:'numeric',month:'long',day:'numeric',weekday:'long'}) %>
      </div>
      <h1 style="margin:0;font-size:28px;font-weight:800;color:var(--text-primary);letter-spacing:-.02em;">
        嗨，繼續學習吧 🌱<% if (tested) { %><span style="font-size:14px;font-weight:500;color:var(--text-muted);margin-left:12px;">（測試模式）</span><% } %>
      </h1>
    </div>
    <a href="/" class="button button-primary">＋ 新增任務</a>
  </div>

  <!-- Tested Alert -->
  <% if (tested) { %>
  <div class="alert alert-info" style="margin-bottom:24px;">
    🔍 已執行提醒檢查，請查看終端機輸出或確認 LINE 是否收到訊息。
  </div>
  <% } %>

  <!-- Summary Grid -->
  <div class="summary-grid" style="margin-bottom:40px;">

    <!-- Today Reminders -->
    <div class="summary-card">
      <div class="summary-num <% if(stats.todayCount>0){ %>grad-red<% } else { %>grad-blue<% } %>" style="font-size:40px;">
        <%= stats.todayCount %>
      </div>
      <div class="summary-label">今日提醒</div>
      <% if (stats.todayCount > 0) { %>
        <div class="summary-sub">今天加油！💪</div>
      <% } else { %>
        <div class="summary-sub summary-sub-muted">今天暫無</div>
      <% } %>
    </div>

    <!-- Active Tasks -->
    <div class="summary-card">
      <div class="summary-num grad-blue" style="font-size:40px;"><%= stats.activeCount %></div>
      <div class="summary-label">進行中</div>
      <div class="summary-sub summary-sub-muted">共 <%= tasks.length %> 個</div>
    </div>

    <!-- Next Reminder -->
    <div class="summary-card">
      <% if (stats.nextReminder) { %>
        <div class="summary-num" style="font-size:22px;line-height:1.2;font-weight:700;color:var(--text-primary);">
          <%= fmtTime(stats.nextReminder.remind_at) %>
        </div>
        <div class="summary-label">下次提醒</div>
        <div class="summary-sub summary-sub-muted" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;">
          <%= stats.nextReminder.task_title %>
        </div>
      <% } else { %>
        <div class="summary-num" style="font-size:40px;color:var(--text-muted);">—</div>
        <div class="summary-label">下次提醒</div>
        <div class="summary-sub summary-sub-muted">暫無排程</div>
      <% } %>
    </div>

    <!-- Overdue -->
    <div class="summary-card">
      <div class="summary-num <% if(stats.overdueCount>0){ %>grad-amber<% } else { %>grad-green<% } %>" style="font-size:40px;">
        <%= stats.overdueCount %>
      </div>
      <div class="summary-label">已逾期</div>
      <% if (stats.overdueCount > 0) { %>
        <div class="summary-sub" style="color:#b45309;">需注意 ⚠️</div>
      <% } else { %>
        <div class="summary-sub summary-sub-muted">全部準時</div>
      <% } %>
    </div>

  </div>

  <!-- 今天要做 Section -->
  <div style="margin-bottom:40px;">
    <div class="section-header" style="margin-bottom:16px;">
      <h2 class="section-title">今天要做</h2>
      <% if (todayReminders.length > 0) { %>
        <a href="/test-reminder" class="button button-ghost button-sm">手動觸發</a>
      <% } %>
    </div>

    <% if (todayReminders.length === 0) { %>
      <div class="card">
        <div class="empty-state">
          <div class="empty-icon">☀️</div>
          <div class="empty-title">今天沒有排定提醒</div>
          <div class="empty-desc">可以新增一個任務，讓學伴幫你安排下一步。</div>
          <a href="/" class="button button-primary" style="margin-top:12px;">＋ 新增任務</a>
        </div>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:12px;">
        <% todayReminders.forEach(function(r) {
          const rDate = new Date(r.remind_at);
          const now = new Date();
          const isPast = rDate < now;
          const timeStr = rDate.toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit'});
          let toolsArr = [];
          try { toolsArr = typeof r.tools === 'string' ? JSON.parse(r.tools) : (r.tools || []); } catch(e){}
        %>
        <div style="background:var(--bg-card);border-radius:var(--r-card);box-shadow:var(--shadow-card);border:1px solid var(--border);display:grid;grid-template-columns:90px 1fr auto;gap:14px;padding:16px 20px;align-items:center;">
          <!-- Time -->
          <div style="text-align:center;border-right:1px solid var(--border-light);padding-right:14px;">
            <div style="font-weight:700;font-size:18px;color:<%= isPast ? 'var(--text-muted)' : 'var(--text-primary)' %>;">
              <%= timeStr %>
            </div>
            <div style="font-size:11px;margin-top:3px;color:<%= isPast ? 'var(--text-muted)' : '#2563eb' %>;">
              <%= isPast ? '已過' : '待傳送' %>
            </div>
          </div>
          <!-- Content -->
          <div style="min-width:0;">
            <div style="font-weight:700;font-size:15px;color:var(--text-primary);margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
              <%= r.task_title %>
            </div>
            <% if (r.step) { %>
              <div style="font-size:13px;color:var(--text-secondary);margin-bottom:4px;">📌 <%= r.step %></div>
            <% } %>
            <% if (toolsArr.length > 0) { %>
              <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
                <% toolsArr.forEach(function(t){ %>
                  <span class="pill pill-blue" style="font-size:11px;"><%= t %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
          <!-- Action -->
          <div>
            <a href="/tasks/<%= r.task_id %>" class="button button-secondary button-sm">查看</a>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- 即將到來 Section -->
  <div style="margin-bottom:40px;">
    <div class="section-header" style="margin-bottom:16px;">
      <h2 class="section-title">即將到來</h2>
      <span style="font-size:13px;color:var(--text-muted);">超前進度 🚀</span>
    </div>

    <% if (upcomingReminders.length === 0) { %>
      <div style="border:1.5px dashed var(--border);border-radius:var(--r-card);padding:32px;">
        <div class="empty-state">
          <div class="empty-icon">🗓</div>
          <div class="empty-title">沒有近期提醒</div>
        </div>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <% upcomingReminders.forEach(function(r) {
          const rDate = new Date(r.remind_at);
          const daysAhead = Math.ceil((rDate - new Date()) / 86400000);
          let dayLabel = '';
          if (daysAhead === 1) dayLabel = '明天';
          else if (daysAhead === 2) dayLabel = '後天';
          else dayLabel = daysAhead + ' 天後';
          const dateStr = rDate.toLocaleDateString('zh-TW',{month:'2-digit',day:'2-digit'});
          const timeStr = rDate.toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit'});
          let toolsArr = [];
          try { toolsArr = typeof r.tools === 'string' ? JSON.parse(r.tools) : (r.tools || []); } catch(e){}
        %>
        <div style="background:var(--bg-card);border-radius:var(--r-card);box-shadow:var(--shadow-sm);border:1px solid var(--border);display:grid;grid-template-columns:90px 1fr auto;gap:14px;padding:14px 18px;align-items:center;">
          <!-- Day Info -->
          <div style="text-align:center;border-right:1px solid var(--border-light);padding-right:14px;">
            <div style="font-size:13px;font-weight:700;color:#0d9488;margin-bottom:2px;"><%= dayLabel %></div>
            <div style="font-size:12px;color:var(--text-secondary);"><%= dateStr %></div>
            <div style="font-size:12px;color:var(--text-muted);"><%= timeStr %></div>
          </div>
          <!-- Content -->
          <div style="min-width:0;">
            <div style="font-weight:600;font-size:14px;color:var(--text-primary);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
              <%= r.task_title %>
            </div>
            <% if (r.step) { %>
              <div style="font-size:12px;color:var(--text-secondary);">📌 <%= r.step %></div>
            <% } %>
            <% if (toolsArr.length > 0) { %>
              <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
                <% toolsArr.forEach(function(t){ %>
                  <span class="pill pill-teal" style="font-size:11px;"><%= t %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
          <!-- Action -->
          <div>
            <a href="/tasks/<%= r.task_id %>" class="button button-ghost button-sm">查看 →</a>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- 所有任務 Section -->
  <div>
    <div class="section-header" style="margin-bottom:16px;">
      <h2 class="section-title">所有任務</h2>
      <span class="badge badge-active" style="font-size:12px;"><%= tasks.length %> 個</span>
    </div>

    <% if (tasks.length === 0) { %>
      <div class="card">
        <div class="empty-state">
          <div class="empty-icon">📭</div>
          <div class="empty-title">還沒有任何任務</div>
          <div class="empty-desc">點擊「新增任務」讓學伴幫你規劃學習計畫。</div>
          <a href="/" class="button button-primary" style="margin-top:12px;">＋ 新增任務</a>
        </div>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:12px;padding-bottom:48px;">
        <% tasks.forEach(function(task) {
          const now = new Date();
          const deadline = task.deadline ? new Date(task.deadline) : null;
          const isCompleted = task.status === 'completed';
          const isOverdue = deadline && deadline < now && !isCompleted;
          const hasTodayReminder = todayReminders.some(r => r.task_id === task.id);
          const t = tc(task.task_type);

          let badgeClass, badgeLabel;
          if (isCompleted) { badgeClass = 'badge-done'; badgeLabel = '已完成'; }
          else if (isOverdue) { badgeClass = 'badge-overdue'; badgeLabel = '已逾期'; }
          else if (hasTodayReminder) { badgeClass = 'badge-today'; badgeLabel = '今日有提醒'; }
          else if (task.status === 'active') { badgeClass = 'badge-active'; badgeLabel = '進行中'; }
          else if (task.status === 'pending') { badgeClass = 'badge-pending'; badgeLabel = '待開始'; }
          else { badgeClass = ''; badgeLabel = task.status || '—'; }
        %>
        <div class="card" style="padding:18px 22px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
          <!-- Left: icon + text -->
          <div style="display:flex;align-items:center;gap:14px;flex:1;min-width:0;">
            <div class="icon-circle <%= t.ic %>" style="flex-shrink:0;font-size:18px;">
              <%= t.emoji %>
            </div>
            <div style="min-width:0;flex:1;">
              <div style="font-weight:700;font-size:15px;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px;">
                <%= task.title %>
              </div>
              <% if (task.goal) { %>
                <div style="font-size:13px;color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:5px;">
                  <%= task.goal %>
                </div>
              <% } %>
              <div style="display:flex;flex-wrap:wrap;gap:10px;font-size:12px;color:var(--text-muted);">
                <% if (task.deadline) { %>
                  <span>📅 <%= new Date(task.deadline).toLocaleDateString('zh-TW',{month:'2-digit',day:'2-digit'}) %>
                    <span style="color:<%= isOverdue ? '#b91c1c' : 'var(--text-muted)' %>;">（<%= daysLeft(task.deadline) %>）</span>
                  </span>
                <% } %>
                <% if (task.next_reminder) { %>
                  <span>⏰ <%= fmtTime(task.next_reminder) %></span>
                <% } %>
                <% if (task.reminder_count > 0) { %>
                  <span>🔔 <%= task.reminder_count %> 個提醒</span>
                <% } %>
              </div>
            </div>
          </div>
          <!-- Status badge -->
          <span class="badge <%= badgeClass %>" style="flex-shrink:0;"><%= badgeLabel %></span>
          <!-- Actions -->
          <div style="display:flex;gap:6px;flex-shrink:0;align-items:center;">
            <a href="/tasks/<%= task.id %>" class="button button-secondary button-sm">查看</a>
            <a href="/tasks/<%= task.id %>/edit" class="button button-ghost button-sm">✏️</a>
            <form action="/tasks/<%= task.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('確定要刪除「<%= task.title %>」嗎？此操作無法復原。');">
              <button type="submit" class="button button-ghost button-sm" style="color:#dc2626;">🗑</button>
            </form>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

</div>

</body>
</html>
