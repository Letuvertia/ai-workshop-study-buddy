# =============================================
# 伺服器設定
# =============================================
PORT=3000
DATABASE_PATH=./data/app.db

# =============================================
# 選項一：是否使用本機 LLM
# true  → 呼叫 LLM 自動產生任務規劃
# false → 依截止時間用固定規則產生提醒
# =============================================
USE_LLM=true

# 本機 LLM API 網址
# Ollama:    http://localhost:11434/api/chat
# LM Studio: http://localhost:1234/v1/chat/completions
LOCAL_LLM_API_URL=http://localhost:11434/api/chat

# LLM 模型名稱（Ollama 用）
LOCAL_LLM_MODEL=llama3

# =============================================
# 選項二：提醒方式
# console → 直接在終端機印出（方便測試）
# line    → 透過 LINE push message 提醒
# =============================================
REMINDER_CHANNEL=console

# =============================================
# 選項三：是否需要確認提醒
# true  → 顯示確認頁，讓你確認後才儲存
# false → AI 產生後直接儲存
# =============================================
REQUIRE_CONFIRMATION=true

# =============================================
# 選項四：是否啟用 LINE 回覆互動
# false → 只有 push message，不處理回覆
# true  → 可在 LINE 回覆「完成」「延後30分鐘」「查看下一步」
# =============================================
ENABLE_LINE_REPLY=false

# =============================================
# LINE Bot 設定（REMINDER_CHANNEL=line 時才需要）
# 取得方式請看 README.md
# =============================================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_CHANNEL_SECRET=
