<%- include('partials/header', { pageTitle: task.title + ' — 數位學伴' }) %>

<%
const TC = {
  '語言學習': {ic:'ic-red',    pill:'pill-red',    grad:'grad-red',    emoji:'🗣️'},
  '課程作業': {ic:'ic-blue',   pill:'pill-blue',   grad:'grad-blue',   emoji:'📚'},
  '程式':     {ic:'ic-green',  pill:'pill-green',  grad:'grad-green',  emoji:'💻'},
  '研究閱讀': {ic:'ic-purple', pill:'pill-purple', grad:'grad-purple', emoji:'🔬'},
  '寫作':     {ic:'ic-amber',  pill:'pill-amber',  grad:'grad-amber',  emoji:'✍️'},
  '簡報':     {ic:'ic-teal',   pill:'pill-teal',   grad:'grad-teal',   emoji:'📊'},
  '行政':     {ic:'ic-purple', pill:'pill-purple', grad:'grad-purple', emoji:'📋'},
  '規劃':     {ic:'ic-amber',  pill:'pill-amber',  grad:'grad-amber',  emoji:'🗺️'},
  '複習':     {ic:'ic-blue',   pill:'pill-blue',   grad:'grad-blue',   emoji:'🔄'},
  '生活安排': {ic:'ic-green',  pill:'pill-green',  grad:'grad-green',  emoji:'🏠'},
};
function tc(type) { return TC[type] || {ic:'ic-gray', pill:'pill-gray', grad:'', emoji:'📌'}; }
%>

<div class="page-shell" style="max-width:820px;">

  <% if (created) { %>
    <div class="alert alert-success">✅ 任務已建立！到提醒時間系統會自動傳送通知。</div>
  <% } %>

  <!-- Page Header -->
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:28px;flex-wrap:wrap;">
    <div>
      <a href="/tasks" style="font-size:13px;color:var(--text-secondary);text-decoration:none;display:inline-flex;align-items:center;gap:4px;margin-bottom:12px;">← 任務總覽</a>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div class="icon-circle <%= tc(task.task_type).ic %>"><%= tc(task.task_type).emoji %></div>
        <h1 style="font-size:24px;font-weight:800;margin:0;color:var(--text-primary);"><%= task.title %></h1>
        <span class="badge badge-<%= task.status %>">
          <%= task.status === 'active' ? '進行中' : task.status === 'completed' ? '已完成' : task.status %>
        </span>
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;flex-shrink:0;margin-top:28px;">
      <a href="/tasks/<%= task.id %>/edit" class="button button-secondary button-sm">✏️ 編輯</a>
      <form action="/tasks/<%= task.id %>/delete" method="POST" style="display:inline;"
        onsubmit="return confirm('確定要刪除「<%= task.title %>」？\n\n所有提醒也會一併刪除，無法復原。')">
        <button type="submit" class="button button-danger button-sm">🗑 刪除</button>
      </form>
      <a href="/test-reminder" class="button button-ghost button-sm">🔍 提醒</a>
    </div>
  </div>

  <!-- 任務資訊 -->
  <div class="card" style="border-left:3px solid #0984e3;margin-bottom:18px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px 24px;">
      <% if (task.goal) { %>
      <div style="grid-column:1/-1;">
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">任務目標</div>
        <p style="font-size:15px;line-height:1.65;margin:0;color:var(--text-primary);"><%= task.goal %></p>
      </div>
      <% } %>
      <% if (task.content && task.content !== task.goal) { %>
      <div style="grid-column:1/-1;">
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">任務內容</div>
        <p style="font-size:14px;color:var(--text-secondary);line-height:1.65;margin:0;"><%= task.content %></p>
      </div>
      <% } %>
      <% if (task.deadline) { %>
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">截止時間</div>
        <div style="font-size:14px;font-weight:600;color:var(--text-primary);"><%= new Date(task.deadline).toLocaleString('zh-TW') %></div>
      </div>
      <% } %>
      <% if (task.available_time) { %>
      <div>
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">可用時間</div>
        <div style="font-size:14px;font-weight:600;color:var(--text-primary);"><%= task.available_time %></div>
      </div>
      <% } %>
      <% if (suggestedTools && suggestedTools.length) { %>
      <div style="grid-column:1/-1;">
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:8px;">建議工具</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <% suggestedTools.forEach(function(t){ %>
            <span class="pill <%= tc(t).pill %>"><%= t %></span>
          <% }); %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- 任務步驟 -->
  <% if (steps && steps.length) { %>
  <div class="card" style="margin-bottom:18px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
      <h2 style="font-size:18px;font-weight:700;margin:0;color:var(--text-primary);">任務步驟</h2>
      <span class="badge"><%= steps.length %> 個步驟</span>
    </div>
    <div class="timeline">
      <% steps.forEach(function(step, i){ %>
      <div class="timeline-item">
        <div class="timeline-dot timeline-dot-muted"></div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px;flex-wrap:wrap;">
            <strong style="font-size:14px;color:var(--text-primary);"><%= step.title %></strong>
            <% if (step.estimatedMinutes) { %>
              <span style="font-size:12px;color:var(--text-muted);">⏱ <%= step.estimatedMinutes %> 分鐘</span>
            <% } %>
          </div>
          <% if (step.description) { %>
            <p style="font-size:13px;color:var(--text-secondary);line-height:1.6;margin:0 0 6px;"><%= step.description %></p>
          <% } %>
          <% if (step.completionCriteria) { %>
            <div style="font-size:12px;color:var(--text-muted);">✅ <%= step.completionCriteria %></div>
          <% } %>
          <% if (step.toolUsageGuide) { %>
            <div class="guide-box">💡 <%= step.toolUsageGuide %></div>
          <% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- 提醒清單 -->
  <div class="card" style="margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
      <h2 style="font-size:18px;font-weight:700;margin:0;color:var(--text-primary);">提醒清單</h2>
      <span class="badge"><%= reminders.length %> 則</span>
    </div>

    <% if (!reminders || !reminders.length) { %>
      <div class="empty-state">
        <div class="empty-icon">🔕</div>
        <div class="empty-title">沒有設定提醒</div>
        <div class="empty-desc">此任務沒有安排任何提醒。</div>
      </div>
    <% } else { %>
      <% reminders.forEach(function(r){
        let toolsArr = [];
        try { toolsArr = JSON.parse(r.tools || '[]'); } catch(e){}
        const remindDate = new Date(r.remind_at);
        const isPast = remindDate < new Date();
        const statusLabels = { pending: isPast ? '時間已過' : '待傳送', sent: '已傳送', cancelled: '已取消' };
        const statusClasses = { pending: isPast ? 'badge-overdue' : 'badge-pending', sent: 'badge-sent', cancelled: 'badge-cancelled' };
      %>
      <div id="reminder-<%= r.id %>" style="border:1px solid var(--border-light);border-radius:var(--r-sm);padding:14px 16px;margin-bottom:10px;">

        <!-- Header Row -->
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
          <strong style="font-size:14px;color:var(--text-primary);">
            ⏰ <%= remindDate.toLocaleString('zh-TW',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
          </strong>
          <span class="badge <%= statusClasses[r.status] || 'badge-cancelled' %>">
            <%= statusLabels[r.status] || r.status %>
          </span>
          <% if (r.sent_at) { %>
            <span style="font-size:12px;color:var(--text-muted);">傳送於 <%= r.sent_at %></span>
          <% } %>
          <button type="button"
            onclick="toggleReminderEdit(<%= r.id %>)"
            class="button button-ghost button-sm"
            style="margin-left:auto;">✏️ 編輯</button>
        </div>

        <!-- View -->
        <div id="rView_<%= r.id %>">
          <% if (r.step) { %>
            <div style="font-size:13px;color:var(--text-secondary);margin-bottom:6px;">📌 <%= r.step %></div>
          <% } %>
          <% if (toolsArr.length) { %>
            <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;">
              <% toolsArr.forEach(function(t){ %>
                <span class="pill pill-gray" style="font-size:12px;"><%= t %></span>
              <% }); %>
            </div>
          <% } %>
          <div style="font-size:12px;color:var(--text-primary);background:var(--bg-surface);border-radius:var(--r-sm);padding:10px 12px;white-space:pre-wrap;line-height:1.6;"><%= r.message %></div>
          <% if (r.completion_criteria) { %>
            <div style="font-size:12px;color:var(--text-muted);margin-top:6px;">✅ <%= r.completion_criteria %></div>
          <% } %>
        </div>

        <!-- Inline Edit -->
        <div class="inline-edit" id="rEdit_<%= r.id %>">
          <form action="/reminders/<%= r.id %>/update" method="POST">
            <div class="ie-grid">
              <div class="ie-field">
                <label>⏰ 提醒時間</label>
                <input type="datetime-local" name="remindAt"
                  value="<%= (() => { try { return new Date(r.remind_at).toISOString().slice(0,16); } catch(e){ return ''; } })() %>">
              </div>
              <div class="ie-field">
                <label>📌 現在要做</label>
                <input type="text" name="step" value="<%= r.step || '' %>">
              </div>
            </div>
            <div class="ie-field" style="margin-bottom:8px;">
              <label>📩 提醒訊息</label>
              <textarea name="message" rows="4"><%= r.message %></textarea>
            </div>
            <div class="ie-field" style="margin-bottom:12px;">
              <label>✅ 完成標準</label>
              <input type="text" name="completionCriteria" value="<%= r.completion_criteria || '' %>">
            </div>
            <div class="btn-row">
              <button type="submit" class="button button-primary button-sm">儲存</button>
              <button type="button" class="button button-secondary button-sm" onclick="toggleReminderEdit(<%= r.id %>)">取消</button>
              <% if (r.status !== 'cancelled') { %>
                <button type="submit" name="status" value="cancel" class="button button-danger button-sm"
                  style="margin-left:auto;" onclick="return confirm('確定取消此提醒？')">取消提醒</button>
              <% } %>
            </div>
          </form>
        </div>

      </div>
      <% }); %>
    <% } %>
  </div>

  <div class="btn-row">
    <a href="/tasks" class="button button-secondary">← 回到總覽</a>
  </div>

</div>

<script>
function toggleReminderEdit(id) {
  const view = document.getElementById('rView_' + id);
  const edit = document.getElementById('rEdit_' + id);
  const open = edit.classList.toggle('open');
  view.style.display = open ? 'none' : '';
}
const hash = window.location.hash;
if (hash && hash.startsWith('#reminder-')) {
  const id = hash.replace('#reminder-', '');
  setTimeout(function() {
    if (document.getElementById('rEdit_' + id)) toggleReminderEdit(id);
  }, 150);
}
</script>

</body>
</html>
