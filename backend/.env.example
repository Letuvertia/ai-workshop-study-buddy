# 伺服器設定
PORT=3000

# 資料庫路徑（相對於 backend/ 資料夾）
DATABASE_URL=./data/app.db

# 本機 LLM API（OpenAI 相容格式）—— 僅作為第一次啟動、還沒在網頁設定過時的預設值。
# 之後可以直接在網頁右上角「⚙ AI 模型」面板裡設定，不用再回來改這裡。
# Ollama: http://localhost:11434/v1/chat/completions
# LM Studio: http://localhost:1234/v1/chat/completions
LOCAL_LLM_API_URL=http://localhost:11434/v1/chat/completions

# 本機 LLM 使用的模型名稱
# Ollama 範例: llama3, mistral, gemma2
# LM Studio 範例: lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF
LOCAL_LLM_MODEL=llama3

# LINE Messaging API 設定
# 從 LINE Developers Console 取得
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 你的 LINE User ID（用來接收 push message）
# 可從 LINE Developers Console 的 Webhook 測試取得
LINE_USER_ID=your_line_user_id_here
